# Copy this template to .env (ignored). Never enter credentials in this tracked file.
# Public Firebase project identifiers, not administrative credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Set server-only variables as sensitive Vercel environment variables.
FIREBASE_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
APP_ORIGIN=
# Local integration testing only. Never enable emulators in production.
VITE_USE_EMULATORS=false
VITE_FIREBASE_AUTH_EMULATOR_PORT=9098
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8088
